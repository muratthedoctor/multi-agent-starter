{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentResult",
  "type": "object",
  "required": ["task_id", "role", "status", "summary", "files_changed", "tests", "risks"],
  "properties": {
    "task_id": {"type": "string"},
    "role": {"enum": ["orchestrator", "explorer", "coder", "reviewer", "tester"]},
    "status": {"enum": ["completed", "partial", "blocked", "failed"]},
    "summary": {"type": "string"},
    "files_read": {"type": "array", "items": {"type": "string"}},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": {"type": "string"},
          "status": {"enum": ["passed", "failed", "not_run", "blocked"]},
          "result": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": ["string", "null"]},
    "metrics": {
      "type": "object",
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "generation_tokens_per_second": {"type": ["number", "null"], "minimum": 0},
        "wall_time_ms": {"type": ["number", "null"], "minimum": 0},
        "retry_count": {"type": ["integer", "null"], "minimum": 0},
        "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "measurement_source": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
